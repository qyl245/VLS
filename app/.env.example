# Optional source-video root for re-running manifest samples. Uploads do not need it.
VLS_DATA_ROOT=/path/to/dataset/QEVD-FIT/QEVD-FIT-COACH

# Uploaded jobs, SQLite database, and media. Keep outside the source tree in deployment.
VLS_WEBDATA_ROOT=/path/to/artifacts/webdata

# Interpreter used by the backend when invoking RepChain stages.
VLS_PYTHON_EXE=/path/to/app/.venv/bin/python

# Optional job timeout override in seconds.
VLS_JOB_TIMEOUT_S=1800
